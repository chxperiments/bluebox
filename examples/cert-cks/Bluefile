# CKS practice: Kubernetes security tooling.
# This is where a real kernel earns its place. CKS covers AppArmor,
# seccomp, and runtime detection -- all kernel features a plain container
# cannot exercise. The sandbox has its own kernel, so they work here.
#
# Baked in: a k3s cluster (as in cert-cka) plus the userspace security
# tools -- trivy (image scanning), kube-bench (CIS benchmark), kubesec
# (manifest scoring), and apparmor/seccomp userspace.
#
#   bluebox shell cks
#   k3s server &
#   trivy image nginx:latest
#   kube-bench run
#
# Note on Falco: its modern-eBPF probe needs BTF in the guest kernel.
# Whether libkrunfw's kernel ships BTF is worth checking before you rely
# on Falco specifically; the rest of the toolset does not depend on it.

base: docker.io/library/ubuntu:24.04

cpus: 4
ram_mib: 4096
network: bridge
timeout_seconds: 0

packages:
  - curl
  - ca-certificates
  - iptables
  - conntrack
  - socat
  - vim
  - git
  - apparmor
  - apparmor-utils
  - seccomp

run:
  - curl -sfL https://github.com/k3s-io/k3s/releases/latest/download/k3s -o /usr/local/bin/k3s && chmod +x /usr/local/bin/k3s
  - ln -sf /usr/local/bin/k3s /usr/local/bin/kubectl
  - curl -sfL https://github.com/aquasecurity/trivy/releases/download/v0.58.1/trivy_0.58.1_Linux-64bit.tar.gz | tar -xz -C /usr/local/bin trivy
  - curl -sfL https://github.com/aquasecurity/kube-bench/releases/download/v0.9.3/kube-bench_0.9.3_linux_amd64.tar.gz | tar -xz -C /usr/local/bin kube-bench
